@media screen and (max-width: 600px)
	.btn.secondary
		margin-top 10px
	section.main
		.hero
			.heading
				padding 4rem 2rem
		.controls
			justify-content left
		.buttons
			.item, .select-wrapper, select
				width 100%
	.item
		.information
			.actions
				gap 1rem
				applause-button.applause-button
					width 3.6rem
					height 3.6rem
					min-width 3.6rem
					svg, .clap-icon
						width 2rem
						height 2rem
					.clap-count
						font-size 1.1rem
						min-width 1.8rem
						height 1.8rem
	footer
		padding 5rem 5rem 8rem
